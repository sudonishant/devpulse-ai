# Optional: no key means limited local static checks. Never use NEXT_PUBLIC_ for keys.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Mandatory in production; authenticate at a gateway which forwards this bearer token.
DEVPULSE_ENV=development
DEVPULSE_API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
